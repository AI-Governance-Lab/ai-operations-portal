# ============================================================================
# AI Operations Portal - Local Sovereign Environment Template (.env.example)
# 100% Air-Gapped / Cloud-Agnostic Local Perimeter Configuration
# ============================================================================

# Sovereign Gateway & Proxy Authentication Tokens (Replace before production deploy)
SOVEREIGN_GATEWAY_AUTH_TOKEN=replace-with-local-gateway-token
PORTAL_MASTER_KEY=replace-with-strong-random-master-key

# Embedded LiteLLM Execution Mode:
#   - "auto"                : Uses LITELLM_PROXY_URL if reachable, otherwise safe mock fallback
#   - "live"                : Strictly routes sanitized prompts & judges via LITELLM_PROXY_URL
#   - "local-mock-fallback" : 100% standalone zero-key demo mode (Cloud Run / Air-Gap Demo)
LITELLM_PROXY_MODE=local-mock-fallback
LITELLM_CONFIG_PATH=/app/config.yaml

# External or Local LiteLLM Gateway Connection (Works with ANY LiteLLM config)
LITELLM_PROXY_URL=http://127.0.0.1:4001/v1
LITELLM_API_KEY=sk-replace-with-your-litellm-master-or-virtual-key
LITELLM_DEFAULT_MODEL=gemini-3.8-flash
LITELLM_DEFAULT_JUDGES=gemini-3.8-flash,ministral-14b-latest,codestral-2508

# 3-Tier Public Cloud Run Anti-Abuse & Quota Shield (Zero-PII / GDPR-Safe)
PUBLIC_RATE_LIMIT_PER_MIN=10
PUBLIC_DAILY_LIVE_LLM_CAP=200
PUBLIC_MAX_PROMPT_CHARS=1200
PUBLIC_ALLOWED_MODELS=gemini-3.8-flash,ministral-14b-latest

USER_RATE_LIMIT_PER_MIN=60
USER_DAILY_LIVE_LLM_CAP=1000
USER_MAX_PROMPT_CHARS=6000
USER_ALLOWED_MODELS=gemini-3.8-flash,ministral-14b-latest,codestral-2508,deepseek-ai/deepseek-v4-flash-0731
PORTAL_USER_ACCESS_KEYS=

ENABLE_SWAGGER_DOCS=true
CORS_ALLOWED_ORIGINS=*

# Local On-Premises OpenAI-Compatible Inference Endpoints (vLLM / Ollama / Local SLM)
PRIMARY_INFERENCE_API_BASE=http://local-vllm:8000/v1
PRIMARY_INFERENCE_API_KEY=sk-sovereign-local-default-key
SECONDARY_INFERENCE_API_BASE=http://deepseek-r1-local:8000/v1
SECONDARY_INFERENCE_API_KEY=sk-sovereign-fallback-local-key
JUDGE_INFERENCE_API_BASE=http://judge-slm-local:8000/v1
JUDGE_INFERENCE_API_KEY=sk-sovereign-judge-local-key

# Service Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Local Grafana Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=sovereign-admin
