# ============================================================================
# AI Operations Portal - Local Sovereign Environment Template (.env.example)
# 100% Air-Gapped / Cloud-Agnostic Local Perimeter Configuration
# ============================================================================

# Sovereign Gateway & Proxy Authentication Tokens (Local Perimeter Only)
SOVEREIGN_GATEWAY_AUTH_TOKEN=sk-sovereign-local-airgap-token-01
PORTAL_MASTER_KEY=sk-sovereign-gateway-local-master

# Embedded LiteLLM Execution Mode ("local-mock-fallback" works with zero external keys)
LITELLM_PROXY_MODE=local-mock-fallback
LITELLM_CONFIG_PATH=/app/config.yaml

# Local On-Premises OpenAI-Compatible Inference Endpoints (vLLM / Ollama / Local SLM)
PRIMARY_INFERENCE_API_BASE=http://local-vllm:8000/v1
PRIMARY_INFERENCE_API_KEY=sk-sovereign-local-default-key
SECONDARY_INFERENCE_API_BASE=http://deepseek-r1-local:8000/v1
SECONDARY_INFERENCE_API_KEY=sk-sovereign-fallback-local-key
JUDGE_INFERENCE_API_BASE=http://judge-slm-local:8000/v1
JUDGE_INFERENCE_API_KEY=sk-sovereign-judge-local-key

# Service Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Local Grafana Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=sovereign-admin
